<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Counter.Models"
             x:Class="Counter.Views.MainPage"
             x:DataType="models:CounterSaveData">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="AddButton"
            Text="Add Counter"
            Clicked="AddClicked"/>
    </ContentPage.ToolbarItems>
    <AbsoluteLayout x:Name="Display">
        <AbsoluteLayout.GestureRecognizers>
            <PointerGestureRecognizer PointerMoved="OnPointerMoved"/>
            <PointerGestureRecognizer PointerReleased="OnPointerUp"/>
        </AbsoluteLayout.GestureRecognizers>
    </AbsoluteLayout>
</ContentPage>
